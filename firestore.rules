rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to check if the user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Contacts Collection
    match /contacts/{document} {
      // User can only read and write their own contacts
      allow read, update, delete: if isOwner(resource.data.uid);
      // When creating, the uid must match the logged-in user
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Trips Collection
    match /trips/{document} {
      allow read, update, delete: if isOwner(resource.data.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Community Reports Collection
    match /reports/{document} {
      // Anyone authenticated can read reports (for the community feed)
      allow read: if isAuthenticated();
      // Only the owner can update or delete
      allow update, delete: if isOwner(resource.data.uid);
      // Anyone authenticated can create, but uid must be their own
      allow create: if isAuthenticated() 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.text.size() <= 500; // Limit string length!
    }
  }
}
